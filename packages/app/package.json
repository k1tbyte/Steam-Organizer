{
    "name": "@so/app",
    "private": true,
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "exports": {
        ".": "./src/index.ts",
        "./popup": "./src/popup.ts",
        "./autofill": "./src/autofill.ts",
        "./styles.css": "./src/styles.css"
    },
    "imports": {
        "#core": "./src/core/index.ts",
        "#components/*": "./src/components/*",
        "#features/*": "./src/features/*/index.ts"
    },
    "scripts": {
        "typecheck": "vue-tsc --noEmit"
    },
    "dependencies": {
        "@so/ui": "workspace:*",
        "@tanstack/vue-virtual": "^3.13.47",
        "@vueuse/core": "^15.0.0",
        "pinia": "^4.1.0",
        "reka-ui": "^2.11.0",
        "vue-i18n": "^11.4.16",
        "vue-router": "^5.4.0"
    },
    "peerDependencies": {
        "vue": "^3.5.0"
    },
    "devDependencies": {
        "typescript": "~6.0.3",
        "vite": "^8.3.4",
        "vue": "^3.5.44",
        "vue-tsc": "^3.3.13"
    }
}
