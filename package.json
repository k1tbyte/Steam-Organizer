{
    "name": "steam-organizer",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.14.0",
    "engines": {
        "node": ">=24.15"
    },
    "scripts": {
        "dev": "turbo dev --filter=@so/web",
        "dev:ext": "turbo dev --filter=@so/extension",
        "build": "turbo build",
        "typecheck": "turbo typecheck",
        "lint": "biome check .",
        "format": "biome check --write .",
        "test": "vitest run",
        "test:watch": "vitest",
        "perf:build": "pnpm --filter @so/web exec vite build --config ../../tests/perf/vite.config.mjs",
        "arch": "depcruise --config tests/arch/dependency-cruiser.cjs packages/app/src packages/ui/src apps/web/src apps/extension/entrypoints"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@vue/compiler-dom": "^3.5.44",
        "dependency-cruiser": "^18.7.0",
        "playwright": "^1.64.1",
        "turbo": "^2.11.9",
        "typescript": "~6.0.3",
        "vitest": "^5.0.5"
    }
}
